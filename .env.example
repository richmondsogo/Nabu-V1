# Telegram Bot
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Storage
DB_PATH=data/books.db

# Link Resolver Settings
LOCAL_RESULT_THRESHOLD=3
SEARCH_CACHE_TTL=86400
MAX_UPSTREAM=4
POLITE_DELAY_MS=750
CONNECT_TIMEOUT=8
SINGLEFLIGHT_TIMEOUT=15
RESULT_LIMIT=5
USER_BUCKET_TOKENS=5
USER_BUCKET_REFILL=0.5
REFRESH_COOLDOWN=300

# Upstream Mirrors
MIRROR_LIBGEN=https://libgen.li,https://libgen.la,https://libgen.bz,https://libgen.is,https://libgen.rs
